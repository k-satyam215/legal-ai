GROQ_API_KEY=your_groq_api_key_here
# Comma-separated trusted browser origins. Do not use * in production.
ALLOWED_ORIGINS=http://localhost:8501
FAISS_INDEX_FILE=backend/rag/faiss_index.index
METADATA_JSONL=backend/rag/faiss_index_metadata.json
OFFSETS_FILE=backend/rag/faiss_index_offsets.npy
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Redis cache (optional - app works without it using in-memory fallback)
REDIS_HOST=localhost
REDIS_PORT=6379

# Rate limiting on /api/v2/* (protects against abuse + runaway Groq cost).
# In-memory, per-process sliding window. Tune per expected traffic.
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
